# ============================================================
# dialekt-cloud environment variables
# Copy to .env and fill in all values before starting
# ============================================================

# PostgreSQL connection
DATABASE_URL=postgresql://dialekt_cloud:CHANGE_ME@localhost:5432/dialekt_cloud

# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
DIALEKT_ADMIN_KEY=CHANGE_ME_64_CHAR_HEX_SECRET
JWT_SECRET=CHANGE_ME_RANDOM_STRING

# SMTP email settings
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=dialekt.ai <noreply@example.com>
SMTP_TLS=true

# App
APP_URL=https://api.dias.now
ADMIN_URL=https://admin.dias.now
LANDING_URL=https://dialekt.dias.now

# Invoice / founder legal details (Kazakhstan)
INVOICE_SELLER_NAME=ИП Иванов Иван Иванович
INVOICE_SELLER_BIN=123456789012
INVOICE_SELLER_IBAN=KZ00 0000 0000 0000 0000
INVOICE_SELLER_BANK=АО «Kaspi Bank»
INVOICE_SELLER_BIK=CASPKZKA
INVOICE_SELLER_ADDRESS=г. Алматы, ул. Примерная, 1
INVOICE_SELLER_PHONE=+7 (707) 000-00-00
INVOICE_SELLER_EMAIL=hello@dialekt.ai

# Environment
ENV=production
LOG_LEVEL=INFO
