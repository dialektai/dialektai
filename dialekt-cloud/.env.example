# ──────────────────────────────────────────────────────────────────────────
# dialekt-cloud — production .env template
#
# Copy to .env, fill EVERY value. The assert_production_ready() check in
# main.lifespan REFUSES to boot if security-critical knobs are still dev
# defaults or SMTP creds are missing.
#
# Generate fresh secrets via:
#   python -c 'import os,base64; print(base64.b64encode(os.urandom(48)).decode())'   # JWT_SECRET / DIALEKT_ADMIN_KEY
#   python -c 'import os,base64; print(base64.b64encode(os.urandom(32)).decode())'   # DIALEKT_ADMIN_TOTP_KEY (must decode to 32 bytes)
# ──────────────────────────────────────────────────────────────────────────

ENV=production
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dialekt_cloud:CHANGE_ME@db:5432/dialekt_cloud

# ── Admin auth (replaces the old single-static-key model) ────────────────
# Break-glass key — header-only, NEVER renders to HTML, NEVER mints cookies.
# Used only when SSH + CLI is unavailable and you must hit /admin directly.
# 64-char random string. Rotate every 90 days.
DIALEKT_ADMIN_KEY=CHANGE_ME_64_CHAR_RANDOM

# JWT signing material for tenant bearer tokens AND admin session cookies.
# Domain-separated internally (e.g. _admin_session, _master). 48+ bytes b64.
JWT_SECRET=CHANGE_ME_48_BYTE_BASE64

# AES-256-GCM key encrypting admins.totp_secret_encrypted at rest.
# MUST decode to exactly 32 bytes. Rotate by re-encrypting all rows.
DIALEKT_ADMIN_TOTP_KEY=CHANGE_ME_32_BYTE_BASE64

# Domain enforced on admin email creation. Production: @dias.now only.
DIALEKT_ADMIN_EMAIL_DOMAIN=@dias.now

# ── Zoho SMTP (transactional email) ───────────────────────────────────────
# Generate the app password at:
#   accounts.zoho.com → Mail → Settings → Security → Application Passwords
#   → Generate ("dialekt-cloud SMTP")
# This password is NEVER reusable for browser login — safe to store.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_USER=zhumagaliyev@dias.now
SMTP_PASSWORD=CHANGE_ME_ZOHO_APP_PASSWORD
SMTP_FROM=dialekt.ai <hello@dias.now>

# Per-purpose Zoho aliases (defaults are fine — override if your aliases differ).
SMTP_FROM_HELLO=dialekt.ai <hello@dias.now>
SMTP_FROM_SECURITY=dialekt.ai security <security@dias.now>
SMTP_FROM_PRIVACY=dialekt.ai privacy <privacy@dias.now>
SMTP_FROM_BILLING=dialekt.ai billing <billing@dias.now>

# Inbox that receives lead alerts + lockout broadcasts. Defaults to hello@
# (fans out via Zoho aliases). Set to a personal box for on-call.
ADMIN_NOTIFY_TO=hello@dias.now

# ── Public URLs (used in email links + CORS) ─────────────────────────────
APP_URL=https://api.dias.now
ADMIN_URL=https://admin.dias.now
LANDING_URL=https://dialekt.dias.now

# ── KZ Invoice / billing — required before issuing the first invoice ─────
INVOICE_SELLER_NAME=ТОО "Dialekt.ai"
INVOICE_SELLER_BIN=260140001608
INVOICE_SELLER_IBAN=KZ_FILL_IN
INVOICE_SELLER_BANK=
INVOICE_SELLER_BIK=
INVOICE_SELLER_ADDRESS=Республика Казахстан, г. Астана, район Есиль, ул. Е 652, дом 4, помещение 1
INVOICE_SELLER_PHONE=
INVOICE_SELLER_EMAIL=billing@dias.now

# ── Optional knobs (defaults are fine) ────────────────────────────────────
# DIALEKT_TOS_VERSION=1.0
# DIALEKT_PRIVACY_VERSION=1.0
# DIALEKT_TRIAL_DAYS=30
# DIALEKT_TRIAL_SEATS=3
# DIALEKT_SIGNUP_IP_LIMIT=3
# DIALEKT_SIGNUP_IP_WINDOW_DAYS=7
# DIALEKT_DISABLE_SCHEDULER=  # set "true" to disable the trial-expiring scheduler
# DIALEKT_ADMIN_LOCKOUT_BURST=3
# DIALEKT_ADMIN_LOCKOUT_BURST_MIN=15
# DIALEKT_ADMIN_LOCKOUT_HARD=6
# DIALEKT_ADMIN_LOCKOUT_HARD_HOURS=1
